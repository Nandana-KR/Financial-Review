# Optional LLM configuration. Leave unset to run in fully-deterministic rules-only mode.
# The app works end-to-end without any of these.

# Provider: "openai" | "anthropic" | "groq" | "none"
# Groq offers a free tier and uses the OpenAI-compatible API.
FINZ_LLM_PROVIDER=none

# API key for the chosen provider.
FINZ_LLM_API_KEY=

# Optional model override
# defaults: openai=gpt-4o-mini, anthropic=claude-3-5-sonnet-latest, groq=openai/gpt-oss-20b
FINZ_LLM_MODEL=

# Optional: override the SQLite database path.
# FINZ_DB_PATH=finz.db
